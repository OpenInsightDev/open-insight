{
  "name": "@open-insight/core",
  "version": "0.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/OpenInsightDev/open-insight",
  "license": "MIT",
  "author": "Bowei Wang <wozluohd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenInsightDev/open-insight.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json",
      "./*": "./src/*.ts",
      "./internal/*": null,
      "./*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "catalog:",
    "@open-insight/sandbox": "workspace:*",
    "@open-insight/trajectory": "workspace:*",
    "avro-js": "catalog:",
    "chdb": "catalog:",
    "effect": "catalog:",
    "picomatch": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "bumpp": "^12.3.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
