{
  "name": "@open-insight/sandbox-daytona",
  "version": "1.0.4",
  "description": "Daytona sandbox provider for Open Insight.",
  "homepage": "https://github.com/OpenInsightDev/open-insight#readme",
  "bugs": {
    "url": "https://github.com/OpenInsightDev/open-insight/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenInsightDev/open-insight.git",
    "directory": "packages/sandbox-daytona"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@daytona/sdk": "catalog:",
    "effect": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@open-insight/core": "workspace:*"
  }
}
