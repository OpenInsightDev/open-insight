{
  "name": "@open-insight/agent",
  "version": "1.0.4",
  "description": "Effect-based agent provider with sandbox tools, Agent Skills, and MCP support.",
  "homepage": "https://github.com/OpenInsightDev/open-insight#readme",
  "bugs": {
    "url": "https://github.com/OpenInsightDev/open-insight/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenInsightDev/open-insight.git",
    "directory": "packages/agent"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.mjs.map",
    "src/**/*.ts"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/platform-node": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@open-insight/core": "workspace:*",
    "ajv": "catalog:",
    "immer": "catalog:",
    "memfs": "catalog:",
    "ripgrep": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
